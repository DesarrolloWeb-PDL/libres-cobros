# Database
DATABASE_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_PUBLIC_KEY=

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=payment_reminder

# Vercel Cron
CRON_SECRET=

# Public URL used for callbacks and redirects
NEXT_PUBLIC_URL=

# ARCA (ex-AFIP) electronic receipts — server-only, never commit real values.
# Homologación (test) is the default; set ARCA_PRODUCTION=true for production.
ARCA_PRODUCTION=false
# Our company CUIT (cert holder / representative in ARCA "Mis Representaciones").
ARCA_CUIT=
# X.509 private key (PEM). Base64-encoded value also accepted (no BEGIN header).
ARCA_KEY=
# X.509 certificate (PEM). Base64-encoded value also accepted.
ARCA_CERT=
# Secret used to encrypt stored ARCA private keys (AES-256-GCM). Falls back to
# NEXTAUTH_SECRET so a single strong secret can bootstrap local/dev setups.
# In production set this explicitly and rotate it with a migration script.
ARCA_STORAGE_SECRET=
