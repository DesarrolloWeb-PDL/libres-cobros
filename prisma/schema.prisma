generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClubCommissionType {
  PERCENTAGE
  FIXED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Club {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  commissionType  ClubCommissionType  @default(PERCENTAGE)
  commissionValue Float               @default(0)
  status          String              @default("ACTIVE")
  
  // Club customization
  logoUrl         String?
  primaryColor    String              @default("#7c3aed")
  secondaryColor  String              @default("#a78bfa")
  accentColor     String              @default("#5b21b6")
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         Member[]
  feeConfigs      FeeConfig[]
  fees            Fee[]
  payments        Payment[]
  commissions     Commission[]
  closings        MonthlyClosing[]
  smsLogs         SmsLog[]
  siteConfigs     SiteConfig[]
  adminUsers      AdminUser[]
  invoices        ProviderInvoice[]
}

model ProviderInvoice {
  id        String   @id @default(cuid())
  clubId    String
  month     Int
  year      Int
  amount    Float
  status    String   @default("ISSUED") // ISSUED | PAID
  issuedAt  DateTime @default(now())
  paidAt    DateTime?
  club      Club     @relation(fields: [clubId], references: [id])

  @@unique([clubId, month, year])
  @@index([status])
}

model Member {
  id        String   @id @default(cuid())
  clubId    String
  dni       String
  firstName String
  lastName  String
  email     String?
  phone     String?
  category  String   @default("ADULT")
  status    String   @default("ACTIVE")
  joinDate  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  club      Club     @relation(fields: [clubId], references: [id])
  fees      Fee[]
  payments  Payment[]
  smsLogs      SmsLog[]

  @@unique([clubId, dni])
  @@unique([clubId, email])
  @@index([dni])
  @@index([status])
  @@index([category])
  @@index([clubId])
}

model FeeConfig {
  id          String  @id @default(cuid())
  clubId      String
  category    String
  amount      Float
  description String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  club        Club    @relation(fields: [clubId], references: [id])
  fees        Fee[]

  @@unique([clubId, category])
  @@index([category])
  @@index([clubId])
}

model Fee {
  id          String   @id @default(cuid())
  clubId      String
  memberId    String
  feeConfigId String
  month       Int
  year        Int
  amount      Float
  dueDate     DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  club        Club     @relation(fields: [clubId], references: [id])
  member      Member   @relation(fields: [memberId], references: [id])
  feeConfig   FeeConfig @relation(fields: [feeConfigId], references: [id])
  payments    Payment[]
  commissions Commission[]

  @@unique([memberId, month, year])
  @@index([status])
  @@index([dueDate])
  @@index([memberId])
  @@index([clubId, month, year])
}

model Payment {
  id                      String   @id @default(cuid())
  clubId                  String
  feeId                   String
  memberId                String
  amount                  Float
  method                  String
  status                  String   @default("PENDING")
  stripeSessionId         String?
  stripePaymentId         String?
  mercadopagoPaymentId    String?
  mercadopagoPreferenceId String?
  bankTransferRef         String?
  confirmedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  club                    Club     @relation(fields: [clubId], references: [id])
  fee                     Fee      @relation(fields: [feeId], references: [id])
  member                  Member   @relation(fields: [memberId], references: [id])
  commissions             Commission[]

  @@index([feeId])
  @@index([memberId])
  @@index([status])
  @@index([stripePaymentId])
  @@index([mercadopagoPaymentId])
  @@index([clubId])
}

model Commission {
  id        String   @id @default(cuid())
  clubId    String
  paymentId String
  feeId     String
  amount    Float
  rate      Float
  periodId  String?
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id])
  payment   Payment  @relation(fields: [paymentId], references: [id])
  fee       Fee      @relation(fields: [feeId], references: [id])
  period    MonthlyClosing? @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@index([createdAt])
  @@index([clubId])
}

model MonthlyClosing {
  id               String   @id @default(cuid())
  clubId           String
  month            Int
  year             Int
  status           String   @default("OPEN")
  totalPayments    Float    @default(0)
  totalCommissions Float    @default(0)
  commissionRate   Float
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  club             Club     @relation(fields: [clubId], references: [id])
  commissions      Commission[]

  @@unique([clubId, month, year])
  @@index([status])
  @@index([clubId])
}

model SmsLog {
  id         String   @id @default(cuid())
  clubId     String
  memberId   String
  type       String
  message    String
  status     String
  externalId String?
  error      String?
  sentAt     DateTime @default(now())
  club       Club     @relation(fields: [clubId], references: [id])
  member     Member   @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([sentAt])
  @@index([type])
  @@index([clubId])
}

model SiteConfig {
  id        String   @id @default(cuid())
  clubId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  club      Club     @relation(fields: [clubId], references: [id])

  @@unique([clubId, key])
  @@index([clubId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  clubId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  club         Club?    @relation(fields: [clubId], references: [id])
}
