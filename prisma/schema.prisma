generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClubCommissionType {
  PERCENTAGE
  FIXED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Club {
  id              String              @id @default(cuid())
  name            String
  siglas          String?             // Abbreviation for selector
  phone           String?             // Contact phone for the institution
  slug            String              @unique
  commissionType  ClubCommissionType  @default(PERCENTAGE)
  commissionValue Float               @default(0)
  status          String              @default("ACTIVE")

  // Club customization
  logoUrl         String?
  primaryColor    String              @default("#7c3aed")
  secondaryColor  String              @default("#a78bfa")
  accentColor     String              @default("#5b21b6")
  bgColor         String              @default("#f8fafc")

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         Member[]
  plans           Plan[]
  fees            Fee[]
  payments        Payment[]
  commissions     Commission[]
  closings        MonthlyClosing[]
  smsLogs         SmsLog[]
  siteConfigs     SiteConfig[]
  adminUsers      AdminUser[]
  invoices        ProviderInvoice[]
  autoDebits      AutoDebit[]
  comprobantes    Comprobante[]
}

model ProviderInvoice {
  id        String   @id @default(cuid())
  clubId    String
  month     Int
  year      Int
  amount    Float
  status    String   @default("ISSUED") // ISSUED | PAID
  issuedAt  DateTime @default(now())
  paidAt    DateTime?
  club      Club     @relation(fields: [clubId], references: [id])

  @@unique([clubId, month, year])
  @@index([status])
}

model Member {
  id        String   @id @default(cuid())
  clubId    String
  dni       String
  cuit      String?  // Employer CUIT for ARCA receipt emission (optional)
  ivaCondicion String @default("CF") // CF | MONO | RI | EXENTO (CondicionIvaReceptor)
  firstName String
  lastName  String
  email     String?
  phone     String?
  category  String   @default("ADULT") // Legacy field, kept for backward compat
  planId    String? // FK to Plan
  status    String   @default("ACTIVE")
  joinDate  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  club      Club     @relation(fields: [clubId], references: [id])
  plan      Plan?    @relation(fields: [planId], references: [id])
  fees      Fee[]
  payments  Payment[]
  smsLogs      SmsLog[]
  autoDebits   AutoDebit[]
  comprobantes Comprobante[]

  @@unique([clubId, dni])
  @@unique([clubId, email])
  @@index([dni])
  @@index([status])
  @@index([category])
  @@index([clubId])
  @@index([planId])
}

model Plan {
  id          String  @id @default(cuid())
  clubId      String
  name        String
  amount      Float
  description String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  club        Club    @relation(fields: [clubId], references: [id])
  fees        Fee[]
  members     Member[]

  @@unique([clubId, name])
  @@index([name])
  @@index([clubId])
}

model Fee {
  id          String   @id @default(cuid())
  clubId      String
  memberId    String
  planId      String
  month       Int
  year        Int
  amount      Float
  dueDate     DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  club        Club     @relation(fields: [clubId], references: [id])
  member      Member   @relation(fields: [memberId], references: [id])
  plan        Plan     @relation(fields: [planId], references: [id])
  payments    Payment[]
  commissions Commission[]

  @@unique([memberId, month, year])
  @@index([status])
  @@index([dueDate])
  @@index([memberId])
  @@index([clubId, month, year])
}

model Payment {
  id                      String   @id @default(cuid())
  clubId                  String
  feeId                   String
  memberId                String
  amount                  Float
  method                  String
  status                  String   @default("PENDING")
  stripeSessionId         String?
  stripePaymentId         String?
  mercadopagoPaymentId    String?
  mercadopagoPreferenceId String?
  bankTransferRef         String?
  confirmedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  club                    Club     @relation(fields: [clubId], references: [id])
  fee                     Fee      @relation(fields: [feeId], references: [id])
  member                  Member   @relation(fields: [memberId], references: [id])
  commissions             Commission[]
  comprobante             Comprobante?

  @@index([feeId])
  @@index([memberId])
  @@index([status])
  @@index([stripePaymentId])
  @@index([mercadopagoPaymentId])
  @@index([clubId])
}

model Commission {
  id        String   @id @default(cuid())
  clubId    String
  paymentId String
  feeId     String
  amount    Float
  rate      Float
  periodId  String?
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id])
  payment   Payment  @relation(fields: [paymentId], references: [id])
  fee       Fee      @relation(fields: [feeId], references: [id])
  period    MonthlyClosing? @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@index([createdAt])
  @@index([clubId])
}

model MonthlyClosing {
  id               String   @id @default(cuid())
  clubId           String
  month            Int
  year             Int
  status           String   @default("OPEN")
  totalPayments    Float    @default(0)
  totalCommissions Float    @default(0)
  commissionRate   Float
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  club             Club     @relation(fields: [clubId], references: [id])
  commissions      Commission[]

  @@unique([clubId, month, year])
  @@index([status])
  @@index([clubId])
}

model SmsLog {
  id         String   @id @default(cuid())
  clubId     String
  memberId   String
  type       String
  message    String
  status     String
  externalId String?
  error      String?
  sentAt     DateTime @default(now())
  club       Club     @relation(fields: [clubId], references: [id])
  member     Member   @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([sentAt])
  @@index([type])
  @@index([clubId])
}

model SiteConfig {
  id        String   @id @default(cuid())
  clubId    String?
  key       String
  value     String
  
  // Super admin theme customization
  primaryColor    String  @default("#7c3aed")
  secondaryColor  String  @default("#a78bfa")
  accentColor     String  @default("#5b21b6")
  bgColor         String  @default("#f8fafc")

  updatedAt DateTime @updatedAt
  club      Club?    @relation(fields: [clubId], references: [id])

  @@unique([clubId, key])
  @@index([clubId])
}

model AutoDebit {
  id                    String   @id @default(cuid())
  clubId                String
  memberId              String
  gateway               String   // 'mercadopago' | 'stripe'
  gatewaySubscriptionId String   // MP preapproval ID or Stripe subscription ID
  status                String   @default("PENDING_AUTH") // PENDING_AUTH | ACTIVE | PAUSED | CANCELLED | FAILED
  amount                Float    // monthly amount locked at subscription creation
  payerEmail            String?
  nextBillingAt         DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  club                  Club     @relation(fields: [clubId], references: [id])
  member                Member   @relation(fields: [memberId], references: [id])

  @@unique([clubId, memberId]) // one auto-debit per member per club
  @@unique([gateway, gatewaySubscriptionId])
  @@index([clubId])
  @@index([status])
}

// ARCA (ex-AFIP) electronic receipt — Phase 1: Recibo C (tipo 15) only.
// One row per confirmed payment emission attempt. `paymentId` is unique so the
// row itself is the idempotency lock for the emission.
model Comprobante {
  id          String   @id @default(cuid())
  clubId      String
  paymentId   String   @unique
  memberId    String
  tipo        Int      @default(15)
  ptoVta      Int
  nro         Int
  cae         String   @default("")
  caeVto      DateTime?
  total       Float
  docTipo     Int
  docNro      Int
  condicionIvaReceptor Int
  estado      String   @default("PENDIENTE") // PENDIENTE | AUTORIZADO | ERROR
  error       String?
  rawRequest  String?
  rawResponse String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  club        Club     @relation(fields: [clubId], references: [id])
  payment     Payment  @relation(fields: [paymentId], references: [id])
  member      Member   @relation(fields: [memberId], references: [id])

  @@index([clubId])
  @@index([estado])
}

model AdminUser {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  role              AdminRole @default(ADMIN)
  clubId            String?
  mustChangePassword Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  club              Club?    @relation(fields: [clubId], references: [id])
}
